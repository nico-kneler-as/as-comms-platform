exports[`ComposeStep snapshots > renders the empty compose state 1`] = `"<section class="flex h-full flex-col"><div class="flex items-start justify-between gap-4 pb-6"><div><p class="text-[11px] font-semibold uppercase text-slate-500">Step 4</p><h2 class="mt-2 text-balance text-2xl font-semibold text-slate-900">Compose the campaign</h2><p class="mt-2 max-w-3xl text-pretty text-sm leading-6 text-slate-500">Reuse the existing composer patterns, then spot-check the live preview against real audience data before freezing the send.</p></div><div class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600">Saved 12s ago</div></div><div class="grid min-h-0 flex-1 gap-6 xl:grid-cols-2"><div class="flex min-h-0 flex-col rounded-xl border border-slate-200 bg-white"><div class="border-b border-slate-200 px-5 py-5"><input placeholder="Write the subject line" class="h-auto border-none px-0 py-0 text-2xl font-semibold text-slate-900 shadow-none focus-visible:ring-0" aria-label="Campaign subject" value=""/><input placeholder="Optional preheader text" class="mt-3 border-none px-0 py-0 text-sm text-slate-500 shadow-none focus-visible:ring-0" aria-label="Campaign preheader" value=""/></div><div class="min-h-0 flex-1 px-5 pb-5 pt-5"><div><div data-editor="true"></div><div class="rounded-b-2xl border border-t-0 border-slate-200 bg-slate-50"><div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-3 py-2"><div data-toolbar="true"></div><div class="flex flex-wrap items-center gap-2"><div><button variant="outline">Insert merge token</button><div><button type="button">{{firstName}}</button><button type="button">{{projectName}}</button><button type="button">{{aliasEmail}}</button></div></div><button variant="outline">Send test</button></div></div><div class="flex items-center gap-2 px-4 py-2 text-xs text-slate-500">Footer + unsubscribe auto-appended</div></div></div></div></div><div class="flex min-h-0 flex-col rounded-xl border border-slate-200 bg-white"><div class="flex items-center justify-between gap-3 border-b border-slate-200 px-5 py-4"><div><p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Live Preview</p></div><div class="flex items-center gap-2"><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">Sample</span><button variant="outline" class="size-8" disabled="" aria-label="Previous sample contact"></button><button variant="outline" class="size-8" disabled="" aria-label="Next sample contact"></button></div></div><div class="min-h-0 flex-1 overflow-y-auto"><div class="border-b border-slate-200 bg-slate-50"><div class="grid grid-cols-[68px_minmax(0,1fr)] gap-3 border-b border-slate-200 px-5 py-3 text-sm last:border-b-0"><span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">From</span><span class="min-w-0 truncate text-slate-800">—</span></div><div class="grid grid-cols-[68px_minmax(0,1fr)] gap-3 border-b border-slate-200 px-5 py-3 text-sm last:border-b-0"><span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">To</span><span class="min-w-0 truncate text-slate-800">—</span></div><div class="grid grid-cols-[68px_minmax(0,1fr)] gap-3 border-b border-slate-200 px-5 py-3 text-sm last:border-b-0"><span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Subject</span><span class="min-w-0 truncate text-slate-800">—</span></div></div><div class="px-5 py-5"><div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-10 text-center text-sm text-slate-500">Add audience filters to load a preview contact.</div></div></div><div class="border-t border-slate-200 px-5 py-4 text-xs text-slate-500">Preview loads once the audience resolves.</div></div></div><div class="mt-6 flex items-center justify-between border-t border-slate-200 pt-6"><button variant="outline">Back</button><button>Continue to review</button></div></section>"`;

exports[`ComposeStep snapshots > renders the populated merge-token preview state 1`] = `
"<section class="flex h-full flex-col"><div class="flex items-start justify-between gap-4 pb-6"><div><p class="text-[11px] font-semibold uppercase text-slate-500">Step 4</p><h2 class="mt-2 text-balance text-2xl font-semibold text-slate-900">Compose the campaign</h2><p class="mt-2 max-w-3xl text-pretty text-sm leading-6 text-slate-500">Reuse the existing composer patterns, then spot-check the live preview against real audience data before freezing the send.</p></div><div class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600">Saved 12s ago</div></div><div class="grid min-h-0 flex-1 gap-6 xl:grid-cols-2"><div class="flex min-h-0 flex-col rounded-xl border border-slate-200 bg-white"><div class="border-b border-slate-200 px-5 py-5"><input placeholder="Write the subject line" class="h-auto border-none px-0 py-0 text-2xl font-semibold text-slate-900 shadow-none focus-visible:ring-0" aria-label="Campaign subject" value="Gear pickup for {{firstName}}"/><input placeholder="Optional preheader text" class="mt-3 border-none px-0 py-0 text-sm text-slate-500 shadow-none focus-visible:ring-0" aria-label="Campaign preheader" value="Everything you need for tomorrow."/></div><div class="min-h-0 flex-1 px-5 pb-5 pt-5"><div><div data-editor="true">Hi {{firstName}},

See you at the warehouse.

Best,
AS</div><div class="rounded-b-2xl border border-t-0 border-slate-200 bg-slate-50"><div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-3 py-2"><div data-toolbar="true"></div><div class="flex flex-wrap items-center gap-2"><div><button variant="outline">Insert merge token</button><div><button type="button">{{firstName}}</button><button type="button">{{projectName}}</button><button type="button">{{aliasEmail}}</button></div></div><button variant="outline">Send test</button></div></div><div class="flex items-center gap-2 px-4 py-2 text-xs text-slate-500">Footer + unsubscribe auto-appended</div></div></div></div></div><div class="flex min-h-0 flex-col rounded-xl border border-slate-200 bg-white"><div class="flex items-center justify-between gap-3 border-b border-slate-200 px-5 py-4"><div><p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Live Preview</p></div><div class="flex items-center gap-2"><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">Sample · SW</span><button variant="outline" class="size-8" aria-label="Previous sample contact"></button><button variant="outline" class="size-8" aria-label="Next sample contact"></button></div></div><div class="min-h-0 flex-1 overflow-y-auto"><div class="border-b border-slate-200 bg-slate-50"><div class="grid grid-cols-[68px_minmax(0,1fr)] gap-3 border-b border-slate-200 px-5 py-3 text-sm last:border-b-0"><span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">From</span><span class="min-w-0 truncate text-slate-800">forests@adventurescientists.org</span></div><div class="grid grid-cols-[68px_minmax(0,1fr)] gap-3 border-b border-slate-200 px-5 py-3 text-sm last:border-b-0"><span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">To</span><span class="min-w-0 truncate text-slate-800">sam@example.org</span></div><div class="grid grid-cols-[68px_minmax(0,1fr)] gap-3 border-b border-slate-200 px-5 py-3 text-sm last:border-b-0"><span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Subject</span><span class="min-w-0 truncate text-slate-800">Gear pickup for Sam Waters</span></div></div><div class="px-5 py-5"><article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><div class="mb-4 rounded-2xl bg-slate-50 px-4 py-3 text-xs text-slate-500">Previewing as Sam Waters</div><div class="prose prose-sm max-w-none text-slate-800 [&amp;_a]:text-sky-700 [&amp;_a]:underline [&amp;_hr]:border-slate-200"><p>Hi Sam Waters,</p><p>See you at the warehouse.</p></div></article></div></div><div class="border-t border-slate-200 px-5 py-4 text-xs text-slate-500">Resolves merge tokens for Sam Waters. Links open in new tabs — click any to spot-check.</div></div></div><div class="mt-6 flex items-center justify-between border-t border-slate-200 pt-6"><button variant="outline">Back</button><button>Continue to review</button></div></section>"
`;

