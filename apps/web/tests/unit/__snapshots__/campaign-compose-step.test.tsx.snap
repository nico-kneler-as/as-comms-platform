// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ComposeStep snapshots > renders populated subject and body controls 1`] = `
"<section class="flex h-full flex-col"><header class="flex items-start justify-between gap-4 pb-5"><div class="min-w-0"><h2 class="text-balance text-xl font-semibold tracking-tight text-slate-900">Write your email</h2><p class="mt-2 max-w-2xl text-pretty text-[13px] leading-relaxed text-slate-500">Draft the subject, preheader, and body. The rendered email preview comes next.</p></div><div class="shrink-0"><a href="/broadcasts/media" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-[11.5px] font-medium text-slate-600 underline underline-offset-4 hover:text-slate-900">Media library ↗</a></div></header><div class="overflow-hidden rounded-xl border border-slate-200 bg-white"><div class="border-b border-slate-200 bg-slate-50/40 px-4 py-3"><label class="inline-flex items-center gap-2 text-[12px] font-medium text-slate-700"><input id="campaign-ab-subject-test" type="checkbox" aria-label="Enable A/B subject test" class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-400"/><span>A/B test subject line</span></label><p class="mt-1 text-[11px] text-slate-500">Split the frozen audience 50/50 between subject A and subject B.</p></div><div class="flex items-baseline gap-3 border-b border-slate-200 px-4 py-2.5"><label for="campaign-subject" class="w-[72px] shrink-0 text-[9.5px] font-medium uppercase tracking-[0.1em] text-slate-500">Subject</label><input id="campaign-subject" placeholder="What recipients see in their inbox" class="h-auto flex-1 border-none bg-transparent px-0 py-0 text-[14.5px] font-semibold tracking-tight text-slate-900 shadow-none placeholder:font-normal focus-visible:ring-0" aria-label="Broadcast subject" value="Gear pickup for {{firstName}}"/><span class="shrink-0 font-mono text-[10.5px] tabular-nums text-slate-500">29/70</span></div><div class="flex items-baseline gap-3 border-b border-slate-200 px-4 py-2"><label for="campaign-preheader" class="w-[72px] shrink-0 text-[9.5px] font-medium uppercase tracking-[0.1em] text-slate-500">Preview</label><input id="campaign-preheader" placeholder="Preheader text - shown next to the subject in most clients" class="h-auto flex-1 border-none bg-transparent px-0 py-0 text-[12.5px] text-slate-800 shadow-none focus-visible:ring-0" aria-label="Broadcast preheader" value="Everything you need for tomorrow."/></div><div class="flex flex-wrap items-center gap-2 border-b border-slate-200 bg-slate-50/60 px-4 py-2 text-[11px] text-slate-500"><span class="font-medium text-slate-600">Merge tags:</span><button type="button" class="inline-flex items-center rounded-md border border-slate-200 bg-white px-1.5 py-0.5 font-mono text-[10.5px] text-slate-600 transition-colors hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50">{{firstName}}</button><button type="button" class="inline-flex items-center rounded-md border border-slate-200 bg-white px-1.5 py-0.5 font-mono text-[10.5px] text-slate-600 transition-colors hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50">{{projectName}}</button><button type="button" class="inline-flex items-center rounded-md border border-slate-200 bg-white px-1.5 py-0.5 font-mono text-[10.5px] text-slate-600 transition-colors hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50">{{aliasEmail}}</button><span class="ml-auto text-[10.5px] text-slate-500">Inserts into the active subject field.</span></div><div><div data-editor="true">Hi {{firstName}},

See you at the warehouse.

Best,
AS</div><div class="border-t border-slate-200 bg-slate-50/70"><div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-3 py-1.5"><div class="flex flex-wrap items-center gap-1"><div data-toolbar="true"></div><div><button variant="ghost" aria-label="Insert merge token" class="size-7"></button><div><button type="button">{{firstName}}</button><button type="button">{{projectName}}</button><button type="button">{{aliasEmail}}</button></div></div></div><span class="font-mono text-[10.5px] tabular-nums text-slate-500">9 <span class="text-slate-400">words</span></span></div><div class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2 text-[11px] text-slate-500"><span class="inline-flex items-center gap-1.5">AS footer and unsubscribe links are appended automatically.</span><span class="ml-auto text-slate-500">Preview and send a test on the next step.</span></div></div></div></div><footer class="mt-auto flex items-center justify-between gap-3 pt-5"><div class="flex items-center gap-3"><button type="button" variant="outline" class="gap-1.5">Back</button></div><button type="button" aria-disabled="false" class="gap-1.5 active:scale-[0.98] active:transition-transform motion-reduce:active:scale-100">Continue</button></footer></section>"
`;

exports[`ComposeStep snapshots > renders the compact compose state without inline preview 1`] = `"<section class="flex h-full flex-col"><header class="flex items-start justify-between gap-4 pb-5"><div class="min-w-0"><h2 class="text-balance text-xl font-semibold tracking-tight text-slate-900">Write your email</h2><p class="mt-2 max-w-2xl text-pretty text-[13px] leading-relaxed text-slate-500">Draft the subject, preheader, and body. The rendered email preview comes next.</p></div><div class="shrink-0"><a href="/broadcasts/media" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-[11.5px] font-medium text-slate-600 underline underline-offset-4 hover:text-slate-900">Media library ↗</a></div></header><div class="overflow-hidden rounded-xl border border-slate-200 bg-white"><div class="border-b border-slate-200 bg-slate-50/40 px-4 py-3"><label class="inline-flex items-center gap-2 text-[12px] font-medium text-slate-700"><input id="campaign-ab-subject-test" type="checkbox" aria-label="Enable A/B subject test" class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-400"/><span>A/B test subject line</span></label><p class="mt-1 text-[11px] text-slate-500">Split the frozen audience 50/50 between subject A and subject B.</p></div><div class="flex items-baseline gap-3 border-b border-slate-200 px-4 py-2.5"><label for="campaign-subject" class="w-[72px] shrink-0 text-[9.5px] font-medium uppercase tracking-[0.1em] text-slate-500">Subject</label><input id="campaign-subject" placeholder="What recipients see in their inbox" class="h-auto flex-1 border-none bg-transparent px-0 py-0 text-[14.5px] font-semibold tracking-tight text-slate-900 shadow-none placeholder:font-normal focus-visible:ring-0" aria-label="Broadcast subject" value=""/><span class="shrink-0 font-mono text-[10.5px] tabular-nums text-slate-500">0/70</span></div><div class="flex items-baseline gap-3 border-b border-slate-200 px-4 py-2"><label for="campaign-preheader" class="w-[