r-slate-200 px-3 py-1.5"><div class="flex flex-wrap items-center gap-1"><div data-toolbar="true"></div><div><button variant="ghost" aria-label="Insert merge token" class="size-7"></button><div><button type="button">{{firstName}}</button><button type="button">{{projectName}}</button><button type="button">{{aliasEmail}}</button></div></div></div><span class="font-mono text-[10.5px] tabular-nums text-slate-500">0 <span class="text-slate-400">words</span></span></div><div class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2 text-[11px] text-slate-500"><span class="inline-flex items-center gap-1.5">AS footer and unsubscribe links are appended automatically.</span><span class="ml-auto text-slate-500">Preview and send a test on the next step.</span></div></div></div></div><div class="mt-auto flex items-center justify-between border-t border-slate-200 pt-5"><button variant="outline">Back</button><button>Continue to preview</button></div></section>"`;
