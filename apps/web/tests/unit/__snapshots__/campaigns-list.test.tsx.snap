exports[`CampaignsList snapshots > matches the empty state snapshot 1`] = `"<div class="flex flex-1 px-4 py-6 sm:px-6"><div class="mx-auto flex w-full max-w-[1180px] flex-1 rounded-lg border border-slate-200 bg-white"><div class="flex h-full flex-col items-center justify-center px-10 text-center w-full"><div class="flex size-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-500"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-megaphone size-7 text-slate-500" aria-hidden="true"><path d="M11 6a13 13 0 0 0 8.4-2.8A1 1 0 0 1 21 4v12a1 1 0 0 1-1.6.8A13 13 0 0 0 11 14H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"></path><path d="M6 14a12 12 0 0 0 2.4 7.2 2 2 0 0 0 3.2-2.4A8 8 0 0 1 10 14"></path><path d="M8 6v8"></path></svg></div><p class="mt-5 text-balance text-base font-semibold text-slate-900">No campaigns yet</p><p class="mt-1 max-w-sm text-pretty text-sm leading-6 text-slate-500">Start your first one.</p><div class="mt-5 flex justify-center"><a href="/campaigns/new" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-primary text-primary-foreground shadow hover:bg-primary/90 h-9 px-4 py-2">New campaign</a></div></div></div></div>"`;

exports[`CampaignsList snapshots > matches the mixed-provider list snapshot 1`] = `"<div class="flex min-h-0 flex-1 px-4 py-4 sm:px-6"><div class="mx-auto flex min-h-0 w-full max-w-[1180px] flex-1 flex-col"><div class="pb-3"><div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between"><div class="flex flex-wrap gap-1 rounded-lg bg-transparent p-0"><button type="button" data-campaign-tab="all" class="inline-flex h-8 items-center gap-2 rounded-md px-2.5 text-[12.5px] transition-colors bg-white text-slate-900 shadow-sm ring-1 ring-slate-200"><span class="font-semibold">All</span><span class="rounded-full px-1.5 py-0.5 text-[10.5px] tabular-nums bg-slate-100 text-slate-500">4</span></button><button type="button" data-campaign-tab="drafts" class="inline-flex h-8 items-center gap-2 rounded-md px-2.5 text-[12.5px] transition-colors text-slate-600 hover:bg-white/70"><span class="font-medium">Drafts</span><span class="rounded-full px-1.5 py-0.5 text-[10.5px] tabular-nums text-slate-400">1</span></button><button type="button" data-campaign-tab="scheduled" class="inline-flex h-8 items-center gap-2 rounded-md px-2.5 text-[12.5px] transition-colors text-slate-600 hover:bg-white/70"><span class="font-medium">Scheduled</span><span class="rounded-full px-1.5 py-0.5 text-[10.5px] tabular-nums text-slate-400">1</span></button><button type="button" data-campaign-tab="sending" class="inline-flex h-8 items-center gap-2 rounded-md px-2.5 text-[12.5px] transition-colors text-slate-600 hover:bg-white/70"><span class="font-medium">Sending</span><span class="rounded-full px-1.5 py-0.5 text-[10.5px] tabular-nums text-slate-400">0</span></button><button type="button" data-campaign-tab="complete" class="inline-flex h-8 items-center gap-2 rounded-md px-2.5 text-[12.5px] transition-colors text-slate-600 hover:bg-white/70"><span class="font-medium">Complete</span><span class="rounded-full px-1.5 py-0.5 text-[10.5px] tabular-nums text-slate-400">2</span></button><button type="button" data-campaign-tab="cancelled" class="inline-flex h-8 items-center gap-2 rounded-md px-2.5 text-[12.5px] transition-colors text-slate-600 hover:bg-white/70"><span class="font-medium">Cancelled</span><span class="rounded-full px-1.5 py-0.5 text-[10.5px] tabular-nums text-slate-400">0</span></button></div><div class="flex flex-col gap-3 sm:flex-row sm:items-center"><div><button type="button" class="inline-flex h-9 min-w-[13rem] items-center justify-between rounded-md border border-slate-200 bg-white px-3 text-[13px] text-slate-700"><span class="truncate">All projects</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 text-slate-400" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div><div>Forests</div><div>Killer Whales</div></div></div><label class="flex h-9 min-w-[18rem] items-center gap-2 rounded-md border border-slate-200 bg-white px-3 text-[13px]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search size-4 text-slate-400" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><input data-campaign-search="true" placeholder="Search campaigns" class="w-full bg-transparent text-slate-900 placeholder:text-slate-400 focus:outline-none" type="text" value=""></label></div></div></div><div class="overflow-hidden rounded-lg border border-slate-200 bg-white"><div><a href="/campaigns/postmark-1" data-campaign-row="true" data-campaign-provider="postmark" data-campaign-state="draft" class="grid min-h-[92px] grid-cols-[40px_minmax(0,1fr)] gap-x-3 gap-y-2 border-b border-slate-200 bg-white px-4 py-3 transition-colors hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-slate-400 sm:min-h-0 sm:grid-cols-[40px_minmax(0,1fr)_minmax(150px,190px)] sm:items-center sm:gap-4"><span class="flex size-9 items-center justify-center rounded-lg bg-amber-50 text-amber-700" title="Project"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail size-4" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg></span><div class="min-w-0"><p class="truncate text-[13.5px] font-semibold leading-5 italic text-slate-500">No subject yet</p><div class="mt-0.5 flex min-w-0 items-center gap-2 text-[12px] leading-4 text-slate-500"><span class="shrink-0 rounded bg-slate-100 px-1.5 py-0.5 text-[10.5px] font-medium text-slate-600">forests@</span><p class="truncate"></p></div></div><div class="col-span-2 min-w-0 text-left sm:col-span-1 sm:text-right"><p class="truncate text-[12.5px] font-medium text-slate-900">112 recipients</p><p class="mt-0.5 truncate text-[12px] leading-4 text-slate-500">Saved May 15</p></div></a></div><div><a href="/campaigns/postmark-2" data-campaign-row="true" data-campaign-provider="postmark" data-campaign-state="scheduled" class="grid min-h-[92px] grid-cols-[40px_minmax(0,1fr)] gap-x-3 gap-y-2 border-b border-slate-200 bg-white px-4 py-3 transition-colors hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-slate-400 sm:min-h-0 sm:grid-cols-[40px_minmax(0,1fr)_minmax(150px,190px)] sm:items-center sm:gap-4"><span class="flex size-9 items-center justify-center rounded-lg bg-violet-50 text-violet-700" title="Project"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail s