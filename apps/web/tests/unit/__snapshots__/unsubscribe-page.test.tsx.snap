// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`public unsubscribe page > matches the all-opt-out banner snapshot 1`] = `"<main class="min-h-dvh bg-[linear-gradient(180deg,#f8fafc_0%,#eef4ef_100%)] px-4 py-10 text-slate-900 sm:px-6"><div class="mx-auto flex w-full max-w-2xl flex-col gap-4"><section class="overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-[0_24px_80px_rgba(15,23,42,0.08)]"><div class="border-b border-slate-200/80 px-6 py-5 sm:px-8"><span role="img" aria-label="Adventure Scientists" class="inline-block bg-[#253746] h-8 w-32" style="mask-image:url(/brand/as-mark.png);mask-size:contain;mask-repeat:no-repeat;mask-position:center;-webkit-mask-image:url(/brand/as-mark.png);-webkit-mask-size:contain;-webkit-mask-repeat:no-repeat;-webkit-mask-position:center"></span></div><div class="space-y-6 px-6 py-8 sm:px-8 sm:py-10"><div class="flex items-center gap-3 text-emerald-700"><div class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" class="fill-current/10"></circle><path d="M8 12.5l2.5 2.5L16.5 9"></path></svg></div><div class="text-xs font-semibold uppercase tracking-[0.22em] text-emerald-700/80">Email preferences updated</div></div><div class="space-y-3"><h1 class="text-3xl font-semibold tracking-tight text-slate-900">You&#x27;ve been unsubscribed from Forests emails.</h1><p class="max-w-xl text-sm leading-7 text-slate-700">You won&#x27;t receive any more campaign emails from this project. Your project-team correspondence — replies to direct conversations, trip logistics, gear pickups — will keep flowing as usual.</p></div><div class="inline-flex w-fit rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700">taylor@example.org</div><div class="h-px bg-slate-200"></div><div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-4 text-sm font-medium leading-6 text-emerald-800">Got it. You&#x27;re now unsubscribed from every Adventure Scientists campaign, across every project and the newsletter.</div></div><footer class="border-t border-slate-200/80 bg-slate-50 px-6 py-5 text-sm text-slate-600 sm:px-8"><div class="space-y-1"><p>123 Research Way • Bozeman, MT, 59715 • USA</p><p>Did this happen by mistake? <a href="mailto:info@adventurescientists.org" class="font-medium text-slate-900 underline underline-offset-2">Contact us</a>.</p></div></footer></section></div></main>"`;

exports[`public unsubscribe page > matches the newsletter snapshot 1`] = `"<main class="min-h-dvh bg-[linear-gradient(180deg,#f8fafc_0%,#eef4ef_100%)] px-4 py-10 text-slate-900 sm:px-6"><div class="mx-auto flex w-full max-w-2xl flex-col gap-4"><a href="#unsubscribe-all" class="sr-only rounded-md bg-white px-3 py-2 text-sm font-medium text-slate-900 shadow-sm focus:not-sr-only focus:self-start focus:outline-none focus:ring-2 focus:ring-slate-400">Skip to unsubscribe from all emails</a><section class="overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-[0_24px_80px_rgba(15,23,42,0.08)]"><div class="border-b border-slate-200/80 px-6 py-5 sm:px-8"><span role="img" aria-label="Adventure Scientists" class="inline-block bg-[#253746] h-8 w-32" style="mask-image:url(/brand/as-mark.png);mask-size:contain;mask-repeat:no-repeat;mask-position:center;-webkit-mask-image:url(/brand/as-mark.png);-webkit-mask-size:contain;-webkit-mask-repeat:no-repeat;-webkit-mask-position:center"></span></div><div class="space-y-6 px-6 py-8 sm:px-8 sm:py-10"><div class="flex items-center gap-3 text-emerald-700"><div class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" class="fill-current/10"></circle><path d="M8 12.5l2.5 2.5L16.5 9"></path></svg></div><div class="text-xs font-semibold uppercase tracking-[0.22em] text-emerald-700/80">Email preferences updated</div></div><div class="space-y-3"><h1 class="text-3xl font-semibold tracking-tight text-slate-900">You&#x27;ve been unsubscribed from the AS newsletter.</h1><p class="max-w-xl text-sm leading-7 text-slate-700">You won&#x27;t receive the monthly Adventure Scientists newsletter anymore. If you&#x27;re an active volunteer, project-specific emails will keep coming.</p></div><div class="inline-flex w-fit rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700">taylor@example.org</div><div class="h-px bg-slate-200"></div><div id="unsubscribe-all" class="space-y-4"><p class="text-sm leading-7 text-slate-700">Want to stop every Adventure Scientists email — project updates included?</p><form action="/u/token-news/all" method="post"><button type="submit" class="inline-flex items-center justify-center rounded-full bg-[#253746] px-5 py-3 text-sm font-semibold text-white transition-colors duration-150 hover:bg-[#1c2933] focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2">Unsubscribe from all AS emails →</button></form></div></div><footer class="border-t border-slate-200/80 bg-slate-50 px-6 py-5 text-sm text-slate-600 sm:px-8"><div class="space-y-1"><p>123 Research Way • Bozeman, MT, 59715 • USA</p><p>Did this happen by mistake? <a href="mailto:info@adventurescientists.org" class="font-medium text-slate-900 underline underline-offset-2">Contact us</a>.</p></div></footer></section></div></main>"`;

