exports[`ReviewStep snapshots > renders the editable review state 1`] = `"<section class="flex h-full flex-col"><div class="pb-6"><p class="text-[11px] font-semibold uppercase text-slate-500">Step 5</p><h2 class="mt-2 text-balance text-2xl font-semibold text-slate-900">Review and send</h2><p class="mt-2 max-w-3xl text-pretty text-sm leading-6 text-slate-500">This is the frozen checkpoint before launch. Confirm the sender, audience, rendered content, and send timing.</p></div><div class="space-y-5"><section class="rounded-3xl border border-slate-200 bg-white px-5 py-5"><div class="flex flex-wrap items-center gap-3"><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-slate-700">Forests</span></div><input placeholder="Untitled campaign" class="mt-4 h-auto border-none px-0 py-0 text-3xl font-semibold text-slate-900 shadow-none focus-visible:ring-0" aria-label="Campaign name" value="May forests volunteer update"/><p class="mt-2 text-sm text-slate-500">Internal name only — recipients see the subject line.</p></section><section class="rounded-3xl border border-slate-200 bg-white"><div class="border-b border-slate-200 px-5 py-4"><h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Sender</h3></div><div class="px-5 py-5"><div class="space-y-4"><div class="space-y-2"><label for="campaign-from-email" class="text-sm font-medium text-slate-900">From</label><select id="campaign-from-email" class="flex h-11 w-full rounded-2xl border border-slate-200 bg-white px-3 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-300 disabled:cursor-not-allowed disabled:bg-slate-50 disabled:text-slate-500"><option value="">Choose a verified sender</option><option value="forests@adventurescientists.org" selected="">forests@adventurescientists.org · verified</option></select></div><div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3"><p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Reply-To</p><p class="mt-2 text-sm text-slate-800">forests@adventurescientists.org</p><p class="mt-2 text-xs text-slate-500">Replies route to the same address as the sender.</p></div></div></div></section><section class="rounded-3xl border border-slate-200 bg-white"><div class="border-b border-slate-200 px-5 py-4"><h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Audience</h3></div><div class="px-5 py-5"><div class="flex items-start justify-between gap-4"><div><p class="text-4xl font-semibold tabular-nums text-slate-900">1,247</p><p class="mt-2 text-sm text-slate-500">Frozen at launch · Auto-excludes unsubscribed, bounced, no-email</p></div><button type="button" class="text-sm font-medium text-slate-600 underline underline-offset-2">Re-run audience</button></div></div></section><section class="rounded-3xl border border-slate-200 bg-white"><div class="border-b border-slate-200 px-5 py-4"><h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Email Content</h3></div><div class="px-5 py-5"><button type="button" class="flex w-full items-center justify-between rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-left text-sm font-medium text-slate-800"><span>Collapse</span></button><div class="mt-4 rounded-3xl border border-slate-200"><div class="border-b border-slate-200 px-4 py-3 text-sm text-slate-600"><p><span class="font-medium text-slate-900">Subject:</span> Gear pickup for Sam Waters</p><p class="mt-2"><span class="font-medium text-slate-900">Preheader:</span> Everything you need for tomorrow.</p></div><div class="px-4 py-4"><article class="prose prose-sm max-w-none rounded-2xl border border-slate-200 bg-white p-4 text-slate-800 [&amp;_a]:text-sky-700 [&amp;_a]:underline [&amp;_hr]:border-slate-200"><p>Hi Sam Waters,</p><p>See you at the warehouse.</p></article></div></div></div></section><section class="rounded-3xl border border-slate-200 bg-white"><div class="border-b border-slate-200 px-5 py-4"><h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">When To Send</h3></div><div class="px-5 py-5"><div class="grid gap-3 md:grid-cols-2"><button type="button" class="rounded-2xl border px-4 py-4 text-left transition-colors border-slate-900 bg-slate-900 text-white"><p class="font-semibold">Send now</p><p class="mt-2 text-sm opacity-80">Recipients start receiving immediately</p></button><button type="button" class="rounded-2xl border px-4 py-4 text-left transition-colors border-slate-200 bg-white text-slate-900 hover:bg-slate-50"><p class="font-semibold">Schedule for later</p><p class="mt-2 text-sm opacity-80">Pick a date and time. Locked to America/Denver.</p></button></div></div></section></div><div class="mt-6 flex items-center justify-between border-t border-slate-200 pt-6"><button variant="outline">Back</button><button>Send now</button></div><div data-open="true"><div><div><h2>Send now</h2><p>Send 1,247 emails from forests@adventurescientists.org right now?</p></div><div><button variant="outline">Cancel</button><button>Confirm</button></div></div></div></section>"`;

